ealista.com/ab/98/11/d_0_1424702779.jpg","multimediaId":1424702779,"hasExternalVideoPlayer":false}]},"contactInfo":{"commercialName":"GILMAR LAS PALMAS","phone1":{"phoneNumber":"828640271","formattedPhone":"828 64 02 71","prefix":"34","phoneNumberForMobileDialing":"+34828640271","nationalNumber":true},"contactName":"GILMAR LAS PALMAS","userType":"professional","agencyLogo":"https://st3.idealista.com/4f/f1/32/gilmar-las-palmas.gif","contactMethod":"all","micrositeShortName":"gilmar-las-palmas","totalAds":0,"needLoginForContact":false},"hasLift":true,"parkingSpace":{"hasParkingSpace":true,"isParkingSpaceIncludedInPrice":true},"priceByArea":4258.0,"features":{"hasSwimmingPool":true,"hasTerrace":true,"hasAirConditioning":false,"hasBoxRoom":true,"hasGarden":true},"detailedType":{"typology":"flat"},"suggestedTexts":{"title":"Piso en Carretera de Chile, 27, Negrín, Las Palmas de Gran Canaria"},"hasPlan":true,"has3DTour":false,"has360":false,"hasStaging":false,"highlight":{"groupDescription":"Top"},"savedAd":{},"ribbons":[],"notes":[],"newDevelopmentHighlight":false,"topPlus":false,"topNewDevelopment":false,"preferenceHighlight":false,"topHighlight":true,"urgentVisualHighlight":false,"visualHighlight":false}}
{"ts":"2026-05-15T16:50:15.482148700Z","ss":"IdealistaFeeder","payload":{"propertyCode":"104181342","thumbnail":"https://img4.idealista.com/s/v1/yLv6QcFaPGY-ndqtd3fIzjn3dwgl4inLwTKbMiVSd6Ml4khBqGDIaJvI4s5m5JvBd3qod6Ojd5vOdwZ6Bnp6o_f3JT7I9Zuoyw?Expires=1778950213&Signature=MEUCIHtlp0pFjp5Dnj4LTUbiq8FhZmrJjhiley4y~k7w4V59AiEAwmTVgVw4pSa6FWM~EqAYclTY~jhGmI5GuA-lfpWU0xk_&Key-Pair-Id=K20EOYVFELHOX5","externalReference":"3478-03153","numPhotos":74,"floor":"1","price":699000.0,"priceInfo":{"price":{"amount":699000.0,"currencySuffix":"€"}},"propertyType":"flat","operation":"sale","size":488.0,"exterior":true,"rooms":14,"bathrooms":2,"address":"Piso en Calle Castillo, 12, Vegueta, Las Palmas de Gran Canaria","province":"Las Palmas","municipality":"Las Palmas de Gran Canaria","district":"Vegueta - Triana","country":"es","neighborhood":"Vegueta","locationId":"0-EU-ES-35-01-001-016-05-001","latitude":28.0998353,"longitude":-15.4172499,"showAddress":true,"url":"https://www.idealista.com/inmueble/104181342/","description":"Situada en el corazón del casco histórico de Vegueta en Las Palmas de Gran Canaria, esta propiedad excepcional en la Calle Castillo, 12, captura la esencia de la exclusividad y el potencial. Edificada en la mitad del siglo XX, esta joya arquitectónica ofrece un espacio impresionante de 417 metros cuadrados repartidos en dos plantas. Actualmente configurado como un despacho profesional, el inmueble alberga 14 salas de trabajo, cada una con su propia atmósfera de  tranquilidad y productividad. La flexibilidad de la propiedad es notable. Su diseño y amplitud permiten una transformación sencilla, ya sea para continuar como espacio de oficinas de alta gama o para convertirse en una vivienda de ensueño. La idea de adaptar este espacio para una nueva actividad comercial o remodelarlo en un hogar personalizado brinda una oportunidad única para aquellos con visión y deseo de crear algo verdaderamente excepcional. Además de su vasto interior, la propiedad destaca por un garaje cerrado de 69 metros cuadrados y dos plazas adicionales en un espacio común interior ajardinado, ofreciendo un retiro de paz en el bullicio urbano. La azotea transitable de uso privativo, de 280 metros cuadrados, es una característica impresionante, brindando vistas incomparables al casco antiguo de Vegueta y a la Catedral de Santa Ana. Este espacio al aire libre es perfecto para disfrutar de las vistas panorámicas y la atmósfera única que solo esta ubicación puede ofrecer. Ubicada en una de las zonas más emblemáticas y culturales de Las Palmas, esta propiedad ofrece acceso directo a una rica vida cultural, con museos, centros de arte, restaurantes gourmet y plazas históricas a pocos pasos. La combinación de su ubicación privilegiada, características únicas y potencial ilimitado hacen de esta propiedad una oferta inigualable en el mercado inmobiliario de Las Palmas de Gran Canaria. Esta propiedad no es solo un espacio; es una invitación a formar parte de la historia de Vegueta, a vivir en un entorno lleno de belleza, cultura e historia, o a crear un espacio de trabajo que inspire creatividad y éxito. Sea cual sea su futuro propósito, esta propiedad promete ser el escenario de una vida excepcional o el hogar de una empresa próspera. Los datos expuestos son meramente informativos y pueden estar sujetos a errores u omisiones. Los gastos propios derivados de la compraventa no están incluidos en el precio de venta.","hasVideo":true,"status":"good","newDevelopment":false,"favourite":false,"newProperty":false,"multimedia":{"images":[{"url":"https://img4.idealista.com/s/v1/yLv6QcFaPGY-ndqtd3fIzjn3dwgl4inLwTKbMiVSd6Ml4khBqGDIaJvI4s5m5JvBd3qod6Ojd5vOdwZ6Bnp6o_f3JT7I9Zuoyw?Expires=1778950213&Signature=MEQCIE5ZsCvppDId9kJp36ocz5yduPVYVUR~TugReglfPtTKAiAS-XfLxkW46AyDDQMYIKKPOOM8UbWqkVOGsqjaxbXzGA__&Key-Pair-Id=K20EOYVFELHOX5","tag":"views"},{"url":"https://img4.idealista.com/s/v1/yLv6QcFaPGY-ndqtd3fIzjn3dwgl4inLwTKbMiVSd6Ml4khBqGDIaJvI4s5m5JvBdyWodwu1d_cedwZ6Bnp6o_d6PqPI9