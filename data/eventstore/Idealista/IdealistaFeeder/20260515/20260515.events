vI4s5m5JvBdwsldx61d5sMdwb3gAsLDAgIC4DI9Zuoyw?Expires=1778950213&Signature=MEUCIQDgk-oDB0p0SV1685yWpxSVLwcfKijMdvolk6MBd1H-fgIgA7bBffazyY44JBqjFJUlWV~8BB3ACe~ToDAYkYFrL04_&Key-Pair-Id=K20EOYVFELHOX5","category":"360"}]},"contactInfo":{"commercialName":"RE/MAX Lanzagorta Central","phone1":{"phoneNumber":"828640466","formattedPhone":"828 64 04 66","prefix":"34","phoneNumberForMobileDialing":"+34828640466","nationalNumber":true},"contactName":"Valerio","userType":"professional","agencyLogo":"https://st3.idealista.com/37/36/8b/p00013016.gif","contactMethod":"all","micrositeShortName":"p00013016","totalAds":0,"needLoginForContact":false},"hasLift":true,"parkingSpace":{"hasParkingSpace":true,"isParkingSpaceIncludedInPrice":true},"priceByArea":3323.0,"features":{"hasSwimmingPool":false,"hasTerrace":true,"hasAirConditioning":false,"hasBoxRoom":true,"hasGarden":false},"detailedType":{"typology":"flat"},"suggestedTexts":{"title":"Piso en Plaza Fuero Real de Gran Canaria, Arenales - Lugo - Avda Marítima, Las Palmas de Gran Canaria"},"hasPlan":true,"has3DTour":false,"has360":true,"hasStaging":false,"labels":[{"name":"seaViewsType","text":"Vistas al mar"}],"highlight":{"groupDescription":"Top"},"savedAd":{},"ribbons":[],"notes":[],"newDevelopmentHighlight":false,"topPlus":false,"topNewDevelopment":false,"preferenceHighlight":false,"topHighlight":true,"urgentVisualHighlight":false,"visualHighlight":false}}
{"ts":"2026-05-15T16:50:15.436313600Z","ss":"IdealistaFeeder","payload":{"propertyCode":"101787762","thumbnail":"https://img4.idealista.com/s/v1/yLv6QcFaPGY-ndqtd3fIzjn3dwgl4inLwTKbMiVSd6Ml4khBqGDIaJvI4s5m5JvBd9q1d_cGdwa1dwYG9z4L9yULCHrI9Zuoyw?Expires=1778950213&Signature=MEUCIEb6aJ-D4PkM6LCTZtwIiac2x2fcfhL6d-7f-Eel0Uf3AiEArDcC1aQe1~4BmThkdC2r2P7VeOGHLLOeuAwg1z1hZ6Y_&Key-Pair-Id=K20EOYVFELHOX5","externalReference":"PENTHOUSE B ","numPhotos":26,"floor":"5","price":1361000.0,"priceInfo":{"price":{"amount":1361000.0,"currencySuffix":"€"}},"propertyType":"penthouse","operation":"sale","size":409.0,"exterior":true,"rooms":4,"bathrooms":3,"address":"Ático en Avenida Juan Carlos I, 47, Siete Palmas, Las Palmas de Gran Canaria","province":"Las Palmas","municipality":"Las Palmas de Gran Canaria","district":"Ciudad Alta","country":"es","neighborhood":"Siete Palmas","locationId":"0-EU-ES-35-01-001-016-03-004","latitude":28.1125961,"longitude":-15.4502369,"showAddress":true,"url":"https://www.idealista.com/obra-nueva/101787762/","description":"¡BIENVENIDO A ESTE ESPECTACULAR ATICO!  Este ático de 407 metros cuadrados, un verdadero tesoro urbano que combina lujo, comodidad y elegancia en el corazón de la ciudad. Con un diseño meticuloso y acabados de primera calidad, esta residencia ofrece un estilo de vida sofisticado y contemporáneo. Al entrar en la propiedad, te recibirá un amplio y luminoso salón, perfecto para el entretenimiento o simplemente para relajarte y disfrutar de las vistas panorámicas que ofrece. La disposición de los espacios ha sido cuidadosamente planificada para brindar una sensación de amplitud y fluidez, con una distribución que maximiza la luz natural en cada rincón. La cocina es un paraíso para los amantes de la gastronomía. Con suficiente espacio para la creatividad culinaria y con acabados de primera calidad, este espacio se convierte en el corazón de la casa. El ático cuenta con cuatro habitaciones, cada una diseñada con un estilo único y con armarios empotrados de calidad suprema que ofrecen un amplio espacio de almacenamiento sin comprometer el estilo ni la funcionalidad. Los tres baños, elegantemente diseñados y equipados con materiales de alta gama, añaden un toque de lujo y confort a la experiencia de vivir aquí. Pero lo más impresionante de todo es la increíble terraza y el balcón que ofrecen vistas panorámicas de la ciudad, creando un espacio al aire libre perfecto para disfrutar de cenas al atardecer, reuniones sociales o simplemente relajarse y desconectar. Además, esta propiedad incluye una plaza de garaje, lo que garantiza la comodidad y seguridad de tener tu propio espacio de estacionamiento en el mismo edificio. Este ático es mucho más que una simple residencia; es un oasis de lujo y confort en medio de la ciudad, donde cada detalle ha sido cuidadosamente diseñado para ofrecer una experiencia de vida incomparable. Ahora cobra protagonismo el residencial donde están ubicados estos maravillosos áticos, os cuento; Enclavadas en el prestigioso entorno de Siete Palmas, en la distinguida Calle Juan Carlos I, se erige un magnífico edificio que redefine el concepto de vivienda contemporánea. Este majestuoso complejo residencial alberga un total de veinte viviendas de nueva construcción, incluyendo dos áticos dúplex, cuatro tríplex pareados y tres locales comerciales, fusionando de manera impecable la elegancia arquitectónica con la funcionalidad urbana. Con una ubicación privilegiada junto al Hospital Doctor Negrín y a un breve paseo del exquisito Las Palmeras Golf y el Centro Comercial Las Ramblas, estas viviendas representan la cúspide del estilo de vida moderno y sofisticado en Las Palmas de Gran Canaria. Imponiéndose con su estética impresionante, el edificio se destaca por la meticulosa selección de materiales de primera calidad que se han empleado en su construcción. Las líneas arquitectónicas modernas y vanguardistas definen su silueta, mientras que los ventanales de piso a techo inundan los espacios interiores con una luminosidad natural sin igual, creando un ambiente sereno y acogedor que invita a la contemplación y la relajación. Puedes ampliar información en nuestra página web: WWW.LASRAMBLASLIVING.COM El complejo residencial no solo cautiva por su apariencia visualmente impactante, sino que también ofrece una gama de servicios y comodidades que elevan la experiencia de vida a nuevas alturas. Una piscina comunitaria brinda un oasis de frescura y recreación, mientras que los garajes y trasteros incluidos en el precio garantizan la practicidad y la seguridad en el día a día. Además, la idónea localización del residencial asegura un acceso conveniente a una amplia gama de servicios esenciales, así como una conexión directa con la circunvalación que proporciona acceso rápido y sencillo hacia el norte, el sur y el centro de la isla, facilitando así la exploración de todos los encantos que Gran Canaria tiene para ofrecer. LLÁMENOS YA PARA RESERVAR.","hasVideo":false,"status":"newdevelopment","newDevelopment":true,"favourite":false,"newProperty":false,"multimedia":{"images":[{"url":"https://img4.idealista.com/s/v1/yLv6QcFaPGY-ndqtd3fIzjn3dwgl4inLwTKbMiVSd6Ml4khBqGDIaJvI4s5m5JvBd9q1d_cGdwa1dwYG9z4L9yULCHrI9Zuoyw?Expires=1778950213&Signature=MEUCIELnv5sYPGBelKTiiKTRJwIKu0sKfYEiohVI0hPDPZWZAiEAtiHKgbm0YfmwWOwVivXfYnMuCpEYzKOjd2vT~eB3Jkk_&Key-Pair-Id=K20EOYVFELHOX5","tag":"unknown"},{"url":"https://img4.idealista.com/s/v1/yLv6QcFaPGY-ndqtd3fIzjn3dwgl4inLwTKbMiVSd6Ml4khBqGDIaJvI4s5m5JvBd5sedyUedwYMdwYG9z4L9yULC3rI9Zuoyw?Expires=1778950213&Signature=MEUCIC~7AWVWSzFPHbg9~iyXTe2I7x1YyZO5tdtNzoAGXsIgAiEAyBlucy1o8B7hTvhctHRsdfTzaQPmjLPSTGkaRIHwQDU_&Key-Pair-Id=K20EOYVFELHOX5","tag":"unknown"},{"url":"https://img4.idealista.com/s/v1/yLv6QcFaPGY-ndqtd3fIzjn3dwgl4inLwTKbMiVSd6Ml4khBqGDIaJvI4s5m5JvBd7W1dwaodwYldwYG9z4L9yULo3rI9Zuoyw?Expires=1778950213&Signature=MEYCIQDIyfLSoS9IaffGqycDgc0YNIIcSyElkcorGVDMu5gDAAIhAM65~Im6M0N9cSO9epzGo4Emx5cWg3rUt13NVPVZ4lAv&Key-Pair-Id=K20EOYVFELH